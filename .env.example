# Copy to .env for `docker compose up` — every value below has a working
# default baked into docker-compose.yml, so this file is optional for the
# demo. Override only if you want different Postgres credentials or a
# non-default secret key.

POSTGRES_USER=rpa_sap
POSTGRES_PASSWORD=rpa_sap
POSTGRES_DB=rpa_sap

# demo | production. Controls HSTS + the secret-key/DB-credential fail-fast
# checks in the backend (see backend/app/config.py). Leave as "development"
# for local `docker compose up` unless you're deliberately testing the
# production path. If set to "production", the backend refuses to start
# unless BOTH RPA_SAP_SECRET_KEY and POSTGRES_PASSWORD are overridden below.
APP_ENV=development

# MUST be overridden to a non-default value if APP_ENV=production. Generate
# one with: python scripts/generate_secret_key.py
RPA_SAP_SECRET_KEY=dev-only-secret-change-me

# Comma-separated frontend origin(s) allowed by CORS. The dev default only
# works for localhost; override to your real domain (e.g.
# https://ops.example.com) before deploying anywhere else.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# "full" seeds the literal platform-spec volumes (500+ vendors, 2000+ POs,
# etc. — a few seconds at startup). "small" seeds ~10% for faster iteration.
SEED_SCALE=full

# Max requests/minute per client IP at the backend (see backend/.env.example).
RATE_LIMIT_PER_MINUTE=120

# --- Optional TLS reverse proxy (caddy service, "tls" compose profile) ---
# Only used when running `docker compose --profile tls up`. Defaults to
# "localhost", which gets a locally-trusted self-signed cert with zero
# config. Set to a real hostname (with DNS pointed at this host and ports
# 80/443 reachable) to get a real Let's Encrypt certificate instead.
DOMAIN=localhost
