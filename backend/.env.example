# Copy to backend/.env and fill in real values for non-development environments.

# JWT signing secret. MUST be overridden (non-default) when APP_ENV=production —
# the app fails fast at startup otherwise.
RPA_SAP_SECRET_KEY=dev-only-secret-change-me

# SQLAlchemy database URL. Defaults to a local SQLite file under backend/.
DATABASE_URL=sqlite:///./rpa_sap.db

# Comma-separated list of allowed CORS origins for the frontend.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# development | production. Controls HSTS header and the secret-key fail-fast check.
APP_ENV=development

# JWT access token lifetime, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=480
