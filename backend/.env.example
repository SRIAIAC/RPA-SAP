# Copy to backend/.env and fill in real values for non-development environments.

# JWT signing secret. MUST be overridden (non-default) when APP_ENV=production —
# the app fails fast at startup otherwise. Generate one with:
#   python scripts/generate_secret_key.py
RPA_SAP_SECRET_KEY=dev-only-secret-change-me

# SQLAlchemy database URL. Defaults to a local SQLite file under backend/.
# When APP_ENV=production, this must not contain the docker-compose default
# rpa_sap/rpa_sap credential pair — the app fails fast at startup otherwise.
DATABASE_URL=sqlite:///./rpa_sap.db

# Comma-separated list of allowed CORS origins for the frontend.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# development | production. Controls HSTS header and the secret-key fail-fast check.
APP_ENV=development

# JWT access token lifetime, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Max requests per minute per client IP, enforced by RateLimitMiddleware
# (in-memory, single-process — see app/middleware.py). 0 disables it.
# /api/health and /api/system/health are always exempt.
RATE_LIMIT_PER_MINUTE=120

# demo | production. Informational only (shown in System Health) — does not
# gate behavior. Provider selection below is what actually matters.
APP_MODE=demo

# Provider selection. "mock" (the only supported value today) requires zero
# external credentials and is fully self-contained. Swapping any of these to
# a real provider is a future extension point — see README "Future Production
# Architecture" — and is NOT implemented in this demo.
SAP_PROVIDER=mock
AI_PROVIDER=mock
RPA_PROVIDER=mock
EVENT_BUS=inmemory

# Base URLs of the mock-sap / mock-non-sap services (see mock-systems/).
# Defaults match `docker compose up` service ports when run locally without
# Docker; override MOCK_SAP_BASE_URL/MOCK_NON_SAP_BASE_URL if you run those
# services on different ports.
MOCK_SAP_BASE_URL=http://127.0.0.1:8100
MOCK_NON_SAP_BASE_URL=http://127.0.0.1:8200

# --- Future real-integration placeholders --------------------------------
# None of these are required while the *_PROVIDER settings above are "mock".
# They exist only so the config surface is ready for a future non-mock swap.
OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
SAP_BASE_URL=
SAP_CLIENT_ID=
SAP_CLIENT_SECRET=
UIPATH_BASE_URL=

# --- Optional: real Gmail read-only import (Mailroom testing) ------------
# Lets a Senior Manager+ user hit POST /api/mailroom/import-gmail to pull
# recent real messages into the Mailroom inbox alongside the 15 synthetic
# demo emails, for testing the OCR/classifier pipeline against real data.
# Leave both unset to keep Mailroom fully synthetic (the default).
#
# GMAIL_APP_PASSWORD must be a Google-generated App Password (Google
# Account -> Security -> App passwords, requires 2FA on the account) —
# NEVER your real Google account password. The connection is read-only
# (IMAP readonly select + BODY.PEEK fetches): it never marks messages as
# read, deletes anything, or sends mail.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
